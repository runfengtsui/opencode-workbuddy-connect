{
  "name": "opencode-workbuddy-connect",
  "version": "0.1.1",
  "description": "WorkBuddy AI provider plugin for opencode",
  "keywords": [
    "ai-sdk-provider",
    "opencode",
    "opencode-plugin",
    "workbuddy",
    "codebuddy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runfengtsui/opencode-workbuddy-connect.git"
  },
  "homepage": "https://github.com/runfengtsui/opencode-workbuddy-connect#readme",
  "bugs": {
    "url": "https://github.com/runfengtsui/opencode-workbuddy-connect/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run check && npm run lint && npm run build && node test/run.mjs",
    "test:live": "npm run build && node test/live.mjs && node test/tools.mjs"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@biomejs/biome": "^2.5.13",
    "@opencode/plugin": "2.3.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.0"
  }
}
